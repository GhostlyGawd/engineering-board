{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.github.io/engineering-board/schemas/platform-matrix.schema.json",
  "title": "Engineering Board supported platform matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tools",
    "platforms",
    "containers",
    "limits",
    "permitted_skip_reasons"
  ],
  "properties": {
    "$schema": {
      "const": "./platform-matrix.schema.json"
    },
    "schema_version": {
      "const": "1"
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/versionRange"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "permitted_skip_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "current"
      ],
      "properties": {
        "minimum": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "command",
        "permitted_skip_reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "required": {
          "type": "boolean"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "permitted_skip_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "ci_required",
        "os",
        "architecture",
        "native_shell",
        "runner",
        "tools",
        "surfaces"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]+$"
        },
        "required": {
          "type": "boolean"
        },
        "ci_required": {
          "type": "boolean"
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "minimum",
            "current"
          ],
          "properties": {
            "family": {
              "enum": [
                "linux",
                "macos",
                "windows"
              ]
            },
            "minimum": {
              "type": "string"
            },
            "current": {
              "type": "string"
            }
          }
        },
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "native_shell": {
          "enum": [
            "bash",
            "cmd",
            "powershell"
          ]
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface"
          }
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "host_os",
        "architecture",
        "runtime",
        "surface",
        "permitted_skip_reasons"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "host_os": {
          "type": "array",
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "uniqueItems": true
        },
        "architecture": {
          "enum": [
            "x86_64"
          ]
        },
        "runtime": {
          "type": "object",
          "required": [
            "name",
            "minimum",
            "current"
          ]
        },
        "surface": {
          "type": "string"
        },
        "permitted_skip_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_sessions",
        "exclusive_resources",
        "ports",
        "mcp_fanout",
        "claude_fanout"
      ],
      "properties": {
        "validator_sessions": {
          "const": 2
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "enum": [
              "aggregate",
              "browser",
              "otlp"
            ]
          },
          "uniqueItems": true
        },
        "ports": {
          "type": "array",
          "items": {
            "enum": [
              4173,
              4318
            ]
          },
          "uniqueItems": true
        },
        "mcp_fanout": {
          "const": 5
        },
        "claude_fanout": {
          "const": 3
        }
      }
    }
  }
}
