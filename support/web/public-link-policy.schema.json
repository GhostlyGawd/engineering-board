{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostlygawd.github.io/engineering-board/schemas/public-link-policy.schema.json",
  "title": "Engineering Board public link policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "landing",
    "crawl",
    "resources"
  ],
  "properties": {
    "$schema": {
      "const": "./public-link-policy.schema.json"
    },
    "schema_version": {
      "const": "1"
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "canonical_url",
        "board_path",
        "anchor_count",
        "href_inventory"
      ],
      "properties": {
        "source": {
          "const": "docs/index.html"
        },
        "canonical_url": {
          "const": "https://ghostlygawd.github.io/engineering-board/"
        },
        "board_path": {
          "const": "/engineering-board/board.html"
        },
        "anchor_count": {
          "type": "integer",
          "minimum": 1
        },
        "href_inventory": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_agent",
        "timeout_seconds",
        "max_response_bytes",
        "safe_schemes"
      ],
      "properties": {
        "user_agent": {
          "const": "engineering-board-link-audit/1"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        },
        "safe_schemes": {
          "const": [
            "https"
          ]
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "path_pattern",
        "query_pattern",
        "permitted_redirect_origins",
        "max_redirect_hops",
        "accepted_terminal_statuses",
        "content_marker",
        "fragment_targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+$"
        },
        "path_pattern": {
          "type": "string",
          "minLength": 3
        },
        "query_pattern": {
          "type": "string",
          "minLength": 2
        },
        "permitted_redirect_origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+$"
          }
        },
        "max_redirect_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "accepted_terminal_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 200,
            "maximum": 399
          }
        },
        "content_marker": {
          "type": "string",
          "minLength": 1
        },
        "fragment_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        }
      }
    }
  }
}
