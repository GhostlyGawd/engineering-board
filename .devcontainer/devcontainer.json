{
  "name": "Engineering Board",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "workspaceFolder": "/workspaces/engineering-board",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/engineering-board,type=bind,consistency=cached",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "ENGINEERING_BOARD_DEV_TOOLS": "/opt/engineering-board-tools"
  },
  "postCreateCommand": "bash scripts/bootstrap-dev.sh --check"
}
