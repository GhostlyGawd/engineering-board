{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milestone D.1 memory-evaluation diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_evaluation",
    "first_stated_cause",
    "first_proposed_correction",
    "final_diagnosis",
    "canonical_citations",
    "durable_systemic_conclusion"
  ],
  "properties": {
    "memory_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "memory_status",
        "current_incident_ids",
        "prior_incident_ids",
        "disposition",
        "evidence_or_gap"
      ],
      "properties": {
        "memory_id": {"type": "string", "pattern": "^(?:H|L|P)[0-9]{3,}$"},
        "memory_status": {"type": "string", "minLength": 1},
        "current_incident_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][0-9]{3,}$"}},
        "prior_incident_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][0-9]{3,}$"}},
        "disposition": {"enum": ["apply", "hold", "reject"]},
        "evidence_or_gap": {"type": "string", "minLength": 1}
      }
    },
    "first_stated_cause": {"type": "string", "minLength": 1},
    "first_proposed_correction": {"type": "string", "minLength": 1},
    "final_diagnosis": {"type": "string", "minLength": 1},
    "canonical_citations": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E-D1-(?:V[0-9]+-)?C[0-9]{2}$"}
    },
    "durable_systemic_conclusion": {"type": "boolean"}
  }
}
