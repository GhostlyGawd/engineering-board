{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milestone D.1 agent diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "first_stated_cause",
    "first_proposed_correction",
    "final_diagnosis",
    "canonical_citations",
    "durable_systemic_conclusion"
  ],
  "properties": {
    "first_stated_cause": {
      "type": "string",
      "minLength": 1
    },
    "first_proposed_correction": {
      "type": "string",
      "minLength": 1
    },
    "final_diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "canonical_citations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E-D1-C[0-9]{2}$"
      }
    },
    "durable_systemic_conclusion": {
      "type": "boolean"
    }
  }
}
