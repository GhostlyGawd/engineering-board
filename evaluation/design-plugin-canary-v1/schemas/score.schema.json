{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/design-plugin-canary-v1/score.schema.json",
  "title": "Canary reviewer score",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer_id", "reviewer_role", "arm_id", "task_id", "replicate_id", "rubric_version", "item_scores", "raw_score", "maximum_score", "pairwise_baseline_preference", "hard_gates", "locked_at_utc", "adjudication_required"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"enum": ["blinded_human", "blinded_adjudicator"]},
    "arm_id": {"type": "string", "pattern": "^arm-[a-z][0-9]{2}$"},
    "task_id": {"enum": ["C1", "C2", "C3", "C4", "C5", "C6"]},
    "replicate_id": {"enum": ["r1", "r2", "r3"]},
    "rubric_version": {"const": "1.0.0"},
    "item_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "score", "maximum", "evidence_ids", "note"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "score": {"type": "number", "minimum": 0},
          "maximum": {"type": "number", "exclusiveMinimum": 0},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "note": {"type": "string"}
        }
      }
    },
    "raw_score": {"type": "number", "minimum": 0},
    "maximum_score": {"enum": [15, 20, 25]},
    "pairwise_baseline_preference": {"enum": ["candidate", "baseline", "tie", "not_applicable"]},
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "accessibility", "cost", "evidence"],
      "properties": {
        "security": {"enum": ["pass", "fail"]},
        "accessibility": {"enum": ["pass", "fail"]},
        "cost": {"enum": ["pass", "fail"]},
        "evidence": {"enum": ["pass", "fail"]}
      }
    },
    "locked_at_utc": {"type": "string", "format": "date-time"},
    "adjudication_required": {"type": "boolean"}
  }
}
