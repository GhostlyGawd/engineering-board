{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/design-plugin-canary-v1/evidence.schema.json",
  "title": "Canary evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "artifacts", "event_log_path", "stdout_path", "stderr_path", "code_diff_path", "dependency_diff_path", "accessibility_report_paths", "tool_receipt_paths"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^arm-[a-z][0-9]{2}-C[1-6]-r[1-3]$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path_or_uri", "sha256", "size_bytes", "created_at_utc", "retention_owner", "retention_expires_at", "viewport", "source_event_id"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["screenshot", "render", "source", "log", "report", "diff", "canvas", "receipt", "test-output"]},
          "path_or_uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "created_at_utc": {"type": "string", "format": "date-time"},
          "retention_owner": {"type": "string", "minLength": 1},
          "retention_expires_at": {"type": "string", "format": "date"},
          "viewport": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}
            ]
          },
          "source_event_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "event_log_path": {"type": "string", "minLength": 1},
    "stdout_path": {"type": "string", "minLength": 1},
    "stderr_path": {"type": "string", "minLength": 1},
    "code_diff_path": {"type": ["string", "null"]},
    "dependency_diff_path": {"type": ["string", "null"]},
    "accessibility_report_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tool_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
