{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/design-plugin-canary-v1/editable-canvas-receipt.schema.json",
  "title":"Editable canvas security and provenance receipt",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","arm_id","platform","version","listener","public_listener_detected","zero_cost_receipt_sha256","canvas_locator","canvas_sha256","checked_at_utc","checker"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "arm_id":{"const":"arm-f24"},
    "platform":{"const":"Penpot MCP"},
    "version":{"type":"string","pattern":"^(2\\.(1[5-9]|[2-9][0-9])|[3-9][0-9]*)(\\.[0-9]+)?$"},
    "listener":{"type":"object","additionalProperties":false,"required":["host","port","inspection_command","inspection_output","inspection_output_sha256"],"properties":{"host":{"enum":["127.0.0.1","::1"]},"port":{"type":"integer","minimum":1,"maximum":65535},"inspection_command":{"type":"string","minLength":1},"inspection_output":{"type":"string","minLength":1},"inspection_output_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "public_listener_detected":{"const":false},
    "zero_cost_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "canvas_locator":{"type":"string","minLength":1},
    "canvas_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "checked_at_utc":{"type":"string","format":"date-time"},
    "checker":{"type":"string","minLength":1}
  }
}
