{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/design-plugin-canary-v1/run-manifest.schema.json",
  "title": "Canary run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "protocol_version", "base_commit", "arm_id", "task_id", "replicate_id", "candidate_source", "candidate_version", "candidate_package_sha256", "codex_model", "reasoning_effort", "environment", "permissions", "started_at_utc", "ended_at_utc", "input_sha256", "output_sha256", "zero_cost_receipt_sha256", "native_imagegen_availability_sha256", "observed_quota", "tool_receipt_ids", "scorer_versions", "completion_state", "failure_reason", "elapsed_seconds", "token_usage", "tool_call_count", "free_quota_consumption"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^arm-[a-z][0-9]{2}-C[1-6]-r[1-3]$"},
    "protocol_version": {"const": "1.0.0"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "arm_id": {"type": "string", "pattern": "^arm-[a-z][0-9]{2}$"},
    "task_id": {"enum": ["C1", "C2", "C3", "C4", "C5", "C6"]},
    "replicate_id": {"enum": ["r1", "r2", "r3"]},
    "candidate_source": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "candidate_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codex_model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": "string", "format": "date-time"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "zero_cost_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "native_imagegen_availability_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "observed_quota": {"type": "string", "minLength": 1},
    "tool_receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scorer_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "completion_state": {"enum": ["complete", "failed", "deferred_matched_set"]},
    "failure_reason": {"type": ["string", "null"]},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "token_usage": {"type": "integer", "minimum": 0},
    "tool_call_count": {"type": "integer", "minimum": 0},
    "free_quota_consumption": {"type": "string", "minLength": 1}
  }
}
